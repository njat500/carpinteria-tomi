# Optional. The local application runs without these variables.
# The same public settings can be entered in the Nube y cuenta screen.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Leave false for the free/manual workflow. Enabling requires deploying the Edge
# Function and storing GPT_API_KEY in Supabase secrets, never in VITE_* variables.
VITE_ENABLE_AI=false
